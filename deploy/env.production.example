# Copy this file to .env.production and replace the example values.
# Keep .env.production private (chmod 600); never commit it.

DOMAIN=emoji.example.com
# Optional: uncomment and add an email to the Caddyfile global block if you
# want Let's Encrypt expiry notices.
# ACME_EMAIL=admin@example.com

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
COOKIE_SECURE=1
TRUST_PROXY=1
SEED_DEMO_ACCOUNTS=0
TZ=Asia/Shanghai

DATA_DIR=/app/data
UPLOAD_DIR=/app/uploads
BACKUP_DIR=/app/backups
BACKUP_KEEP=14

# Optional S3-compatible object storage. Set all four values to enable it.
# The app still keeps a local copy for fast reads.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=emoji-vault
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
