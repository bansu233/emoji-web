# 本地开发可直接留空（不复制本文件也能用内置默认值）。
# 部署云端时，请按 README 的「部署到云端」设置生产环境变量。

HOST=127.0.0.1
PORT=3000

# 生产环境改为 production，并启用 HTTPS
# NODE_ENV=production

# 生产环境建议关闭示例账号，再使用 npm run create-user 创建账号
# SEED_DEMO_ACCOUNTS=0

# 仅在需要覆盖默认账号时设置；生产环境必须换成长随机密码
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
REVIEWER_USERNAME=reviewer
# REVIEWER_PASSWORD=

# 本地 HTTP 用 0；生产 HTTPS 用 1
COOKIE_SECURE=0

# 在 Nginx / Caddy 等反向代理后设为 1
# TRUST_PROXY=1

# 可选：把数据库与上传图片放到持久化卷
# DATA_DIR=/var/lib/meme-vault/data
# UPLOAD_DIR=/var/lib/meme-vault/uploads

# 可选：S3 兼容对象存储（四项需同时设置；远程端点须使用 HTTPS）
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=meme-vault
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
